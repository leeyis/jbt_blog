# Copy this file to .env and fill in real values.

# Github Personal Access Token (required for sync_open_source_metrics)
GITHUB_TOKEN=

# Comment notification settings
COMMENT_ADMIN_EMAIL=
COMMENT_NOTIFICATION_MAX_RETRIES=3
COMMENT_NOTIFICATION_BATCH_LIMIT=50
COMMENT_NOTIFICATION_POLL_SECONDS=60
SITE_BASE_URL=http://127.0.0.1:8000

# SMTP settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@jbtblog.local
